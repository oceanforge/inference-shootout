# Created in the DigitalOcean control panel under the Gradient AI Platform.
# This is a MODEL ACCESS KEY, not a DigitalOcean API token — they are different
# credentials created in different places.
DIGITAL_OCEAN_MODEL_ACCESS_KEY=your-model-access-key

# Optional. Comma-separated. Preselected columns, intersected with the live catalog.
DEFAULT_MODELS=openai-gpt-oss-120b,openai-gpt-oss-20b,llama-4-maverick,deepseek-3.2,anthropic-claude-haiku-4.5,mistral-3-14B

# Optional spend guards. Set any to 0 to disable — self-hosters on their own key
# usually want them all off.
MAX_MODELS_PER_RUN=6
MAX_OUTPUT_TOKENS=512
RATE_LIMIT_PER_MINUTE=3
DAILY_BUDGET_USD=5.00
